{
  "name": "mankind-history",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc -p packages/model && tsc -p packages/pipeline && tsc -p packages/viewer",
    "test": "vitest run --passWithNoTests",
    "dev": "pnpm --filter @history/viewer dev",
    "fetch:sources": "tsx packages/pipeline/src/cli.ts fetch",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsx packages/pipeline/src/cli.ts build",
    "extract-fixture": "tsx packages/pipeline/src/cli.ts extract-fixture",
    "histogram": "tsx packages/pipeline/src/cli.ts histogram",
    "fixture:bless": "rm -rf fixtures/dist && tsx packages/pipeline/src/cli.ts build --sources=fixtures --out=fixtures/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "22.20.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
